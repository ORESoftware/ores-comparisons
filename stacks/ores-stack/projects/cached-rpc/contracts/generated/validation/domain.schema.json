{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ores-comparisons.cached-rpc.schema.json",
  "$defs": {
    "CacheState": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CacheState",
      "type": "string",
      "enum": [
        "hit",
        "miss",
        "bypass"
      ]
    },
    "RpcInvocation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RpcInvocation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "cacheKey": {
          "type": "string"
        },
        "cacheState": {
          "$ref": "CacheState"
        },
        "durationMs": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "operation",
        "cacheKey",
        "cacheState",
        "durationMs",
        "createdAt"
      ],
      "unevaluatedProperties": false
    },
    "CacheEntry": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CacheEntry",
      "type": "object",
      "properties": {
        "cacheKey": {
          "type": "string"
        },
        "payloadJson": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "cacheKey",
        "payloadJson",
        "expiresAt",
        "createdAt"
      ],
      "unevaluatedProperties": false
    }
  }
}
