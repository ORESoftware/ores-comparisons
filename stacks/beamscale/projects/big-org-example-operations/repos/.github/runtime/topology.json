{
  "schema": "ores.comparisons.runtime-topology/v1",
  "projectId": "comparebeambigops",
  "stack": "beamscale",
  "scenario": "big-org-example-operations",
  "services": [
    {
      "name": "ingest-service",
      "repository": "ingest-service",
      "role": "service",
      "dependsOn": []
    },
    {
      "name": "automation-worker",
      "repository": "automation-worker",
      "role": "worker",
      "dependsOn": [
        "ingest-service"
      ]
    },
    {
      "name": "ops-console",
      "repository": "ops-console",
      "role": "frontend",
      "dependsOn": [
        "ingest-service",
        "automation-worker"
      ]
    },
    {
      "name": "app",
      "repository": "app",
      "role": "application",
      "dependsOn": [
        "ingest-service",
        "automation-worker",
        "ops-console"
      ]
    }
  ]
}
