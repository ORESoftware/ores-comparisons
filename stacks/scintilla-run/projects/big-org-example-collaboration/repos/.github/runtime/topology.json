{
  "schema": "ores.comparisons.runtime-topology/v1",
  "projectId": "comparescintillabigcollab",
  "stack": "scintilla-run",
  "scenario": "big-org-example-collaboration",
  "services": [
    {
      "name": "presence-service",
      "repository": "presence-service",
      "role": "service",
      "dependsOn": []
    },
    {
      "name": "message-worker",
      "repository": "message-worker",
      "role": "worker",
      "dependsOn": [
        "presence-service"
      ]
    },
    {
      "name": "workspace-web",
      "repository": "workspace-web",
      "role": "frontend",
      "dependsOn": [
        "presence-service",
        "message-worker"
      ]
    },
    {
      "name": "app",
      "repository": "app",
      "role": "application",
      "dependsOn": [
        "presence-service",
        "message-worker",
        "workspace-web"
      ]
    }
  ]
}
