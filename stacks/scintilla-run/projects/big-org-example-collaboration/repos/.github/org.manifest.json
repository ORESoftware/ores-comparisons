{
  "schema": "ores.comparisons.github-org/v1",
  "organization": "scintilla-run-big-org-example-collaboration",
  "stack": "scintilla-run",
  "scenario": "big-org-example-collaboration",
  "repositories": [
    {
      "name": ".github",
      "path": ".github",
      "kind": "governance",
      "dependsOn": []
    },
    {
      "name": "sdk-typescript",
      "path": "sdk-typescript",
      "kind": "generated-sdk",
      "dependsOn": [
        ".github"
      ],
      "generatedFrom": ".github/contracts/generated/interfaces/typescript.ts"
    },
    {
      "name": "presence-service",
      "path": "presence-service",
      "kind": "service",
      "dependsOn": [
        ".github",
        "sdk-typescript"
      ]
    },
    {
      "name": "message-worker",
      "path": "message-worker",
      "kind": "worker",
      "dependsOn": [
        ".github",
        "presence-service"
      ]
    },
    {
      "name": "workspace-web",
      "path": "workspace-web",
      "kind": "frontend",
      "dependsOn": [
        ".github",
        "sdk-typescript",
        "presence-service"
      ]
    },
    {
      "name": "app",
      "path": "app",
      "kind": "application",
      "dependsOn": [
        ".github",
        "presence-service",
        "message-worker",
        "workspace-web"
      ]
    },
    {
      "name": "contract-tests",
      "path": "contract-tests",
      "kind": "contract-tests",
      "dependsOn": [
        ".github",
        "app",
        "presence-service",
        "message-worker",
        "workspace-web"
      ]
    }
  ]
}
