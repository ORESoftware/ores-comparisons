async fnc leaf() => int {
  val scheduler = new OresScheduler(1);
  scheduler.close();
  val doomed = scheduler.start(|| -> {
    return 9;
  });
  return await doomed;
}

async fnc middle() => int {
  val value = await leaf();
  return value + 1;
}

async fnc top() => int {
  val value = await middle();
  return value + 1;
}

pub async routine main() => void {
  val value = await top();
  stdio.println(value);
  return;
}
