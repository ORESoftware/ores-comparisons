{
  "schema_version": "ores.fleet-adversarial.v1",
  "description": "Synthetic non-production fixtures. Every case intentionally plants one or more defects.",
  "cases": [
    {
      "id": "legacy-cli-repository",
      "kind": "cli-pin",
      "input": {
        "repository": "ORESoftware/ores-stack",
        "version": "main"
      },
      "expected_findings": [
        "fleet.cli.legacy-repository",
        "fleet.cli.mutable-version"
      ]
    },
    {
      "id": "shadowed-cli-path",
      "kind": "cli-path",
      "input": {
        "resolved": "/usr/local/bin/ores-stack",
        "pinned": "/opt/ores-stack/bin/ores-stack"
      },
      "expected_findings": [
        "fleet.cli.path-shadowed"
      ]
    },
    {
      "id": "server-contract-digest-mismatch",
      "kind": "server-contract",
      "input": {
        "handler_digest": "sha256:1111",
        "deployment_digest": "sha256:2222"
      },
      "expected_findings": [
        "fleet.server.contract-digest-mismatch"
      ]
    },
    {
      "id": "ambiguous-compose-discovery",
      "kind": "compose-discovery",
      "input": {
        "candidates": [
          "/workspace/.ores-compose.yaml",
          "/workspace/service/.ores-compose.yaml"
        ],
        "explicit_selection": null
      },
      "expected_findings": [
        "fleet.compose.ambiguous-discovery"
      ]
    },
    {
      "id": "unsupported-provider-capability",
      "kind": "provider-capabilities",
      "input": {
        "target": "aws-lambda-http",
        "required": [
          "websocket"
        ],
        "supported": [
          "http",
          "cloudevents"
        ]
      },
      "expected_findings": [
        "fleet.deploy.unsupported-capability"
      ]
    },
    {
      "id": "mutable-artifact-reference",
      "kind": "artifact",
      "input": {
        "reference": "ghcr.io/example/service:latest",
        "digest": null
      },
      "expected_findings": [
        "fleet.deploy.mutable-artifact"
      ]
    },
    {
      "id": "zero-step-pass-receipt",
      "kind": "evidence",
      "input": {
        "state": "passed",
        "executed_steps": 0,
        "source_sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expected_findings": [
        "fleet.evidence.zero-step-pass"
      ]
    },
    {
      "id": "receipt-source-digest-mismatch",
      "kind": "receipt",
      "input": {
        "expected_source_digest": "sha256:abcd",
        "observed_source_digest": "sha256:dcba"
      },
      "expected_findings": [
        "fleet.evidence.source-digest-mismatch"
      ]
    },
    {
      "id": "altered-generated-marker",
      "kind": "generated-ownership",
      "input": {
        "operation": "overwrite",
        "expected_marker": "// @generated by ores-stack",
        "observed_marker": "// @generated by ores-stack edited",
        "target_kind": "regular-file"
      },
      "expected_findings": [
        "fleet.generation.unowned-target"
      ]
    },
    {
      "id": "incomplete-leaf-cache-key",
      "kind": "cache-key",
      "input": {
        "required": [
          "schema",
          "transport",
          "abi",
          "toolchain",
          "target",
          "profile",
          "path",
          "sha256"
        ],
        "present": [
          "schema",
          "transport",
          "abi",
          "target",
          "profile",
          "path",
          "sha256"
        ]
      },
      "expected_findings": [
        "fleet.cache.incomplete-key"
      ]
    },
    {
      "id": "poisoned-leaf-cache-binary",
      "kind": "cache-entry",
      "input": {
        "receipt_regular": true,
        "binary_regular": true,
        "expected_build_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "receipt_build_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "receipt_binary_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "observed_binary_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      },
      "expected_findings": [
        "fleet.cache.poisoned-binary"
      ]
    },
    {
      "id": "unconstrained-plugin-execution",
      "kind": "plugin-exec",
      "input": {
        "executable": "plugin",
        "resolved": "/tmp/plugin",
        "approved_roots": [
          "/opt/ores/plugins"
        ],
        "expected_sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "observed_sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "shell": true,
        "cwd": "/tmp",
        "admitted_root": "/workspace/project",
        "inherited_control_env": [
          "GIT_DIR",
          "SSH_ASKPASS"
        ]
      },
      "expected_findings": [
        "fleet.plugin.cwd-escape",
        "fleet.plugin.digest-mismatch",
        "fleet.plugin.shell-mediated",
        "fleet.plugin.unapproved-executable",
        "fleet.plugin.unsanitized-environment"
      ]
    }
  ]
}
