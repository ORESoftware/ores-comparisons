{
  "schema": "ores.stack.cli-release-safety/v1",
  "canonicalRepository": "https://github.com/ores-stack/ores-stack-cli",
  "implementationStatus": {
    "machineReadableFailures": "contracted-not-yet-canonical",
    "cleanMachineReleaseInstall": "blocked-on-canonical-workspace-closure",
    "downgradeRecovery": "migration-fixture-exercisable"
  },
  "failureEnvelope": {
    "schema": "ores.stack.failure/v1",
    "requiredFields": ["schema", "code", "command", "message", "retryable", "details"],
    "commands": ["build", "dev", "generate", "verify", "deploy"]
  },
  "errorCodes": [
    {"code":"ORES.BUILD.EXECUTION_FAILED","command":"build","retryable":false},
    {"code":"ORES.DEV.LAUNCH_FAILED","command":"dev","retryable":true},
    {"code":"ORES.GENERATE.OWNERSHIP_CONFLICT","command":"generate","retryable":false},
    {"code":"ORES.VERIFY.CONTRACT_FAILED","command":"verify","retryable":false},
    {"code":"ORES.DEPLOY.CAPABILITY_UNSUPPORTED","command":"deploy","retryable":false},
    {"code":"ORES.CONFIG.INVALID","command":"all","retryable":false},
    {"code":"ORES.DEPENDENCY.MISSING","command":"all","retryable":true}
  ],
  "cleanMachine": {
    "requiredDeclaredTools": ["cargo", "rustc", "git"],
    "forbiddenAssumptions": ["globally-installed-ores-stack", "globally-installed-ores-compose", "globally-installed-zed", "undeclared-node-package"],
    "requiredChecks": ["install-immutable-cli", "version-smoke", "representative-project-check", "representative-project-build"],
    "promotionRule": "A released CLI may be marked clean-machine-passed only from an immutable canonical-repository revision with complete workspace closure."
  },
  "recovery": {
    "requiredChecks": [
      "previous-toolchain-installed-separately",
      "candidate-toolchain-installed-separately",
      "activation-switch-is-atomic",
      "post-switch-failure-can-be-injected",
      "previous-toolchain-restored",
      "restored-toolchain-executes",
      "project-config-byte-identical",
      "project-cache-byte-identical"
    ],
    "migrationFixture": {
      "repository": "https://github.com/ORESoftware/ores-stack",
      "previous": "d46c07e0f91c2dbda9b2fee64bdd82f6d52fc1ef",
      "candidate": "2fd66cfaaf0d014f0e27cf29eae6a943928724c5",
      "evidenceClass": "migration-fixture",
      "countsAsReleaseProof": false
    }
  }
}
