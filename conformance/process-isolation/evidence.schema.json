{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ores.faas.tenant-host-isolation-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "platform", "runtime_id", "artifact_sha256", "kernel_boundary",
    "cgroup_v2", "identity_bound_containment", "non_root", "capabilities_empty",
    "no_new_privs", "seccomp", "filesystem_restriction", "pid_isolation",
    "mount_isolation", "ipc_isolation", "network_isolation", "resource_limits",
    "metadata_denied", "sibling_tenant_default_deny", "egress_policy",
    "containment_receipt_redacted", "host_attestation_source"
  ],
  "properties": {
    "schema": { "const": "ores.faas.tenant-host-isolation-evidence/v1" },
    "platform": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "runtime_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "kernel_boundary": { "enum": ["shared_kernel", "microvm", "vm"] },
    "cgroup_v2": { "const": true },
    "identity_bound_containment": { "const": true },
    "non_root": { "const": true },
    "capabilities_empty": { "const": true },
    "no_new_privs": { "const": true },
    "seccomp": { "const": true },
    "filesystem_restriction": { "enum": ["landlock", "mount_namespace", "microvm_guest", "vm_guest", "stronger"] },
    "pid_isolation": { "const": true },
    "mount_isolation": { "const": true },
    "ipc_isolation": { "const": true },
    "network_isolation": { "const": true },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory", "pids", "io"],
      "properties": {
        "cpu": { "const": true },
        "memory": { "const": true },
        "pids": { "const": true },
        "io": { "const": true }
      }
    },
    "metadata_denied": { "const": true },
    "sibling_tenant_default_deny": { "const": true },
    "egress_policy": { "enum": ["deny_all", "allowlist", "brokered"] },
    "containment_receipt_redacted": { "const": true },
    "host_attestation_source": { "enum": ["host_controller", "orchestrator", "microvm_supervisor", "vm_supervisor"] },
    "host_generation": { "type": "string", "minLength": 1, "maxLength": 128 },
    "microvm_required": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "microvm_required": { "const": true } }, "required": ["microvm_required"] },
      "then": { "properties": { "kernel_boundary": { "enum": ["microvm", "vm"] } } }
    }
  ]
}
