{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oresoftware.dev/schemas/ores.comparisons.evidence-receipt.v1.json",
  "title": "ORES Comparisons Evidence Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "identity",
    "producer",
    "executed_checks"
  ],
  "properties": {
    "schema": {
      "const": "ores.comparisons.evidence-receipt/v1"
    },
    "state": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "skipped",
        "not-run"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "dependencies_sha256",
        "config_sha256",
        "toolchain_sha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dependencies_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchain_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "commit"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "external",
            "test-org"
          ]
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "executed_checks": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "executed_checks": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "executed_checks": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "skipped",
              "not-run"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "executed_checks": {
            "maximum": 0
          }
        }
      }
    }
  ]
}
