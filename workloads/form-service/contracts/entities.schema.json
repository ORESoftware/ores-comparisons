{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ores-comparisons.form-service.entities.schema.json",
  "$defs": {
    "SubmissionStatus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SubmissionStatus",
      "type": "string",
      "enum": ["draft", "submitted", "processed"]
    },
    "FormDefinition": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "FormDefinition",
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "form_key": {"type": "string"},
        "title": {"type": "string"},
        "version": {"type": "integer"},
        "active": {"type": "boolean"},
        "created_at": {"type": "string"}
      },
      "required": ["id", "tenant_id", "form_key", "title", "version", "active", "created_at"],
      "unevaluatedProperties": false
    },
    "FormSubmission": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "FormSubmission",
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "form_definition_id": {"type": "string"},
        "status": {"$ref": "SubmissionStatus"},
        "response_json": {"type": "string"},
        "created_at": {"type": "string"}
      },
      "required": ["id", "tenant_id", "form_definition_id", "status", "response_json", "created_at"],
      "unevaluatedProperties": false
    },
    "SubmitFormRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SubmitFormRequest",
      "type": "object",
      "properties": {
        "tenant_id": {"type": "string"},
        "form_definition_id": {"type": "string"},
        "response_json": {"type": "string"}
      },
      "required": ["tenant_id", "form_definition_id", "response_json"],
      "unevaluatedProperties": false
    },
    "SubmitFormResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SubmitFormResponse",
      "type": "object",
      "properties": {"submission": {"$ref": "FormSubmission"}},
      "required": ["submission"],
      "unevaluatedProperties": false
    }
  }
}
