{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ores-comparisons.forms-chat-workflow.entities.schema.json",
  "$defs": {
    "WorkflowStatus": {"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"WorkflowStatus","type":"string","enum":["draft","awaiting_message","completed"]},
    "WorkflowMessageKind": {"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"WorkflowMessageKind","type":"string","enum":["text","system"]},
    "WorkflowRun": {
      "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"WorkflowRun","type":"object",
      "properties":{"id":{"type":"string"},"tenant_id":{"type":"string"},"form_key":{"type":"string"},"status":{"$ref":"WorkflowStatus"},"revision":{"type":"integer","minimum":-2147483648,"maximum":2147483647},"created_at":{"type":"string"}},
      "required":["id","tenant_id","form_key","status","revision","created_at"],"unevaluatedProperties":false
    },
    "FormResponse": {
      "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"FormResponse","type":"object",
      "properties":{"id":{"type":"string"},"tenant_id":{"type":"string"},"workflow_run_id":{"type":"string"},"response_json":{"type":"string"},"created_at":{"type":"string"}},
      "required":["id","tenant_id","workflow_run_id","response_json","created_at"],"unevaluatedProperties":false
    },
    "WorkflowMessage": {
      "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"WorkflowMessage","type":"object",
      "properties":{"id":{"type":"string"},"tenant_id":{"type":"string"},"workflow_run_id":{"type":"string"},"sender_id":{"type":"string"},"kind":{"$ref":"WorkflowMessageKind"},"body":{"type":"string"},"sequence":{"type":"integer","minimum":-2147483648,"maximum":2147483647},"created_at":{"type":"string"}},
      "required":["id","tenant_id","workflow_run_id","sender_id","kind","body","sequence","created_at"],"unevaluatedProperties":false
    },
    "AdvanceWorkflowRequest": {
      "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"AdvanceWorkflowRequest","type":"object",
      "properties":{"tenant_id":{"type":"string"},"workflow_run_id":{"type":"string"},"response_json":{"type":"string"},"message_body":{"type":"string"}},
      "required":["tenant_id","workflow_run_id","response_json","message_body"],"unevaluatedProperties":false
    },
    "AdvanceWorkflowResponse": {
      "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"AdvanceWorkflowResponse","type":"object",
      "properties":{"run":{"$ref":"WorkflowRun"}},"required":["run"],"unevaluatedProperties":false
    }
  }
}
