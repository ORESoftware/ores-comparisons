{
  "schema": "ores.comparisons.storage/v1",
  "tables": [
    {
      "model": "Conversation",
      "name": "conversations",
      "primary_key": ["id"],
      "column_types": {"id": "UUID", "tenant_id": "UUID", "created_at": "TIMESTAMPTZ"},
      "defaults": {"id": "gen_random_uuid()", "created_at": "CURRENT_TIMESTAMP"},
      "indexes": [["tenant_id", "created_at"]]
    },
    {
      "model": "ChatMessage",
      "name": "chat_messages",
      "primary_key": ["id"],
      "column_types": {"id": "UUID", "tenant_id": "UUID", "conversation_id": "UUID", "sender_id": "UUID", "created_at": "TIMESTAMPTZ"},
      "defaults": {"id": "gen_random_uuid()", "sequence": "1", "created_at": "CURRENT_TIMESTAMP"},
      "foreign_keys": [{"column": "conversation_id", "references_table": "conversations", "references_column": "id"}],
      "indexes": [["tenant_id", "conversation_id", "sequence"], ["sender_id"]]
    }
  ]
}
