{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ores-comparisons.realtime-chat.entities.schema.json",
  "$defs": {
    "MessageKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "MessageKind",
      "type": "string",
      "enum": ["text", "image", "system"]
    },
    "Conversation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Conversation",
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "topic": {"type": "string"},
        "created_at": {"type": "string"}
      },
      "required": ["id", "tenant_id", "topic", "created_at"],
      "unevaluatedProperties": false
    },
    "ChatMessage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ChatMessage",
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "conversation_id": {"type": "string"},
        "sender_id": {"type": "string"},
        "kind": {"$ref": "MessageKind"},
        "body": {"type": "string"},
        "sequence": {"type": "integer"},
        "created_at": {"type": "string"}
      },
      "required": ["id", "tenant_id", "conversation_id", "sender_id", "kind", "body", "sequence", "created_at"],
      "unevaluatedProperties": false
    },
    "PublishMessageRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PublishMessageRequest",
      "type": "object",
      "properties": {
        "tenant_id": {"type": "string"},
        "conversation_id": {"type": "string"},
        "sender_id": {"type": "string"},
        "kind": {"$ref": "MessageKind"},
        "body": {"type": "string"}
      },
      "required": ["tenant_id", "conversation_id", "sender_id", "kind", "body"],
      "unevaluatedProperties": false
    },
    "PublishMessageResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PublishMessageResponse",
      "type": "object",
      "properties": {"message": {"$ref": "ChatMessage"}},
      "required": ["message"],
      "unevaluatedProperties": false
    }
  }
}
