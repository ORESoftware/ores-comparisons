{
  "schema": "ores.comparisons.storage/v1",
  "tables": [
    {
      "model": "RpcResource",
      "name": "rpc_resources",
      "primary_key": ["id"],
      "column_types": {"id": "UUID", "tenant_id": "UUID"},
      "defaults": {"id": "gen_random_uuid()", "revision": "1", "active": "TRUE"},
      "indexes": [["tenant_id", "resource_key"]]
    },
    {
      "model": "RpcEvent",
      "name": "rpc_events",
      "primary_key": ["id"],
      "column_types": {"id": "UUID", "tenant_id": "UUID", "resource_id": "UUID"},
      "defaults": {"id": "gen_random_uuid()", "sequence": "1"},
      "foreign_keys": [{"column": "resource_id", "references_table": "rpc_resources", "references_column": "id"}],
      "indexes": [["tenant_id", "resource_id", "sequence"]]
    }
  ]
}
