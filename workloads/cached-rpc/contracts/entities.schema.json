{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ores-comparisons.cached-rpc.entities.schema.json",
  "$defs":{
    "CacheState":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"CacheState","type":"string","enum":["fresh","stale","bypassed"]},
    "RpcMethod":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"RpcMethod","type":"object","properties":{"id":{"type":"string"},"tenant_id":{"type":"string"},"operation_key":{"type":"string"},"transport":{"type":"string"},"active":{"type":"boolean"},"created_at":{"type":"string"}},"required":["id","tenant_id","operation_key","transport","active","created_at"],"unevaluatedProperties":false},
    "RpcCacheEntry":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"RpcCacheEntry","type":"object","properties":{"id":{"type":"string"},"tenant_id":{"type":"string"},"rpc_method_id":{"type":"string"},"cache_key":{"type":"string"},"response_json":{"type":"string"},"state":{"$ref":"CacheState"},"expires_at":{"type":"string"},"revision":{"type":"integer"},"created_at":{"type":"string"}},"required":["id","tenant_id","rpc_method_id","cache_key","response_json","state","expires_at","revision","created_at"],"unevaluatedProperties":false},
    "InvokeCachedRpcRequest":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"InvokeCachedRpcRequest","type":"object","properties":{"tenant_id":{"type":"string"},"operation_key":{"type":"string"},"cache_key":{"type":"string"},"request_json":{"type":"string"}},"required":["tenant_id","operation_key","cache_key","request_json"],"unevaluatedProperties":false},
    "InvokeCachedRpcResponse":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"InvokeCachedRpcResponse","type":"object","properties":{"entry":{"$ref":"RpcCacheEntry"}},"required":["entry"],"unevaluatedProperties":false}
  }
}
