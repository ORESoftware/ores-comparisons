{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ores-comparisons.http-observability.entities.schema.json",
  "$defs": {
    "HttpOutcome": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "HttpOutcome",
      "type": "string",
      "enum": ["ok", "client_error", "server_error"]
    },
    "HttpObservation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "HttpObservation",
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "request_id": {"type": "string"},
        "method": {"type": "string"},
        "path": {"type": "string"},
        "status_code": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "duration_ms": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "outcome": {"$ref": "HttpOutcome"},
        "created_at": {"type": "string"}
      },
      "required": ["id", "tenant_id", "request_id", "method", "path", "status_code", "duration_ms", "outcome", "created_at"],
      "unevaluatedProperties": false
    },
    "TelemetrySpan": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "TelemetrySpan",
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "http_observation_id": {"type": "string"},
        "trace_id": {"type": "string"},
        "span_name": {"type": "string"},
        "duration_ms": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "created_at": {"type": "string"}
      },
      "required": ["id", "tenant_id", "http_observation_id", "trace_id", "span_name", "duration_ms", "created_at"],
      "unevaluatedProperties": false
    },
    "RecordObservationRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RecordObservationRequest",
      "type": "object",
      "properties": {
        "tenant_id": {"type": "string"},
        "request_id": {"type": "string"},
        "method": {"type": "string"},
        "path": {"type": "string"},
        "status_code": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "duration_ms": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}
      },
      "required": ["tenant_id", "request_id", "method", "path", "status_code", "duration_ms"],
      "unevaluatedProperties": false
    },
    "RecordObservationResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RecordObservationResponse",
      "type": "object",
      "properties": {"observation": {"$ref": "HttpObservation"}},
      "required": ["observation"],
      "unevaluatedProperties": false
    }
  }
}
