  "runtime_fixture_policy": {
    "minimum_orgs_per_dedicated_stack": 2,
    "private_repo_transport": "git-submodule",
    "forbidden_source_targets": [
      {
        "source_language": "typescript",
        "artifact_target": "wasm"
      }
    ],
    "dedicated_stacks": [
      "graal-show",
      "iso-lattes",
      "lunatic-lorry",
      "wasm-xprs",
      "pony-expres",
      "ores-stack",
      "litegraph"
    ],
    "repository_family": {
      "count": 20,
      "includes_dot_github": true,
      "name_template": "{org}-{role}",
      "roles": [
        "interfaces",
        "clients",
        "sync",
        "cli",
        "monorepo",
        "infra",
        "desktop-app.rs",
        "flutter",
        "lambdas",
        "api-server{server_extension}",
        "admin-api-server{server_extension}",
        "web-server{server_extension}",
        "admin-web-server{server_extension}",
        "docs",
        "mcp-server{server_extension}",
        "admin-mcp-server{server_extension}",
        "lib-core",
        "pub-lib-core",
        "orm-core"
      ]
    }
  },
