{
  "schema": "ores.comparisons.oreslang-backend-host-matrix/v1",
  "language": "oreslang",
  "backends": [
    {
      "id": "graal",
      "source_repository": "ores-truffle-oreslang/oreslang-source.java",
      "artifact": "graal-runtime-or-native-image",
      "hosts": [
        {
          "stack": "graal-show",
          "status": "planned",
          "isolation": "graal-polyglot-or-native-isolate"
        }
      ]
    },
    {
      "id": "llvm-native",
      "source_repository": "ores-truffle-oreslang/oreslang-source.llvm",
      "artifact": "native",
      "hosts": [
        {
          "stack": "scintilla-run",
          "status": "planned",
          "isolation": "worker-process"
        },
        {
          "stack": "litegraph",
          "status": "planned",
          "isolation": "host-process-specialized"
        }
      ]
    },
    {
      "id": "llvm-wasm",
      "source_repository": "ores-truffle-oreslang/oreslang-source.llvm",
      "artifact": "wasm32-wasi",
      "hosts": [
        {
          "stack": "wasm-xprs",
          "status": "future-backend",
          "isolation": "wasm-instance"
        },
        {
          "stack": "lunatic-lorry",
          "status": "future-backend",
          "isolation": "wasm-actor-process"
        }
      ]
    },
    {
      "id": "wasm",
      "source_repository": "ores-truffle-oreslang/oreslang-source.wasm",
      "artifact": "wasm32-wasi",
      "hosts": [
        {
          "stack": "wasm-xprs",
          "status": "future-backend",
          "isolation": "wasm-instance"
        },
        {
          "stack": "lunatic-lorry",
          "status": "future-backend",
          "isolation": "wasm-actor-process"
        }
      ]
    },
    {
      "id": "dotnet-nativeaot",
      "source_repository": "ores-truffle-oreslang/oreslang-source.net",
      "artifact": "native-aot",
      "implementation_pr": 81,
      "implementation_head": "f3aed954f00ae5e75edfef42b70c253e96ddd99b",
      "hosts": [
        {
          "stack": "scintilla-run",
          "status": "planned",
          "isolation": "worker-process",
          "untrusted_requires_os_sandbox": true,
          "protocol_adapter": "candidate-disconnected",
          "adapter_candidate": {
            "repository": "scintilla-run/gleam-lambda-runner",
            "pr": 55,
            "head": "704c9322334e4da6cfb82a08571c042843d5c43e",
            "codec": "ORW1-v1",
            "port_worker": "candidate-disconnected",
            "live_runtime_registered": false,
            "execution_receipt": null
          }
        }
      ],
      "development_only": {
        "assembly_load_context": {
          "security_boundary": false,
          "strict_nativeaot": false
        }
      },
      "worker_protocol": {
        "schema": "oreslang.dotnet-worker/v1",
        "status": "candidate",
        "magic": "ORW1",
        "version": 1,
        "max_payload_bytes": 1048576,
        "max_invocation_ms": 30000,
        "current_guest_abi": "main() -> i64",
        "payload_lambda_abi": false,
        "request_id_admission": "strictly-increasing",
        "unexpected_guest_failure": "opaque-error-and-retire",
        "scintilla_adapter": "candidate-disconnected"
      }
    },
    {
      "id": "javascript",
      "source_repository": "ores-truffle-oreslang/oreslang-source.js",
      "artifact": "esm",
      "hosts": [
        {
          "stack": "iso-lattes",
          "status": "future-backend",
          "isolation": "javascript-isolate"
        }
      ]
    }
  ],
  "rules": {
    "backend_selects_artifact": true,
    "host_selects_execution_environment": true,
    "assembly_load_context_is_security_boundary": false,
    "wasm_requires_wasm_artifact": true,
    "deployment_status": "not-proven"
  }
}
