{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ores-comparisons.projection-contract.schema.json",
  "$defs": {
    "ProjectionSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ProjectionSchema",
      "type": "string",
      "enum": [
        "ores.comparisons.projection/v1"
      ]
    },
    "ProjectionScenario": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ProjectionScenario",
      "type": "string",
      "enum": [
        "http-observability",
        "forms-chat-workflow",
        "cached-rpc",
        "big-org-example"
      ]
    },
    "SqlType": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SqlType",
      "type": "string",
      "enum": [
        "TEXT",
        "INTEGER",
        "TIMESTAMPTZ",
        "JSONB"
      ]
    },
    "ColumnProjection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ColumnProjection",
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "source": {"type": "string"},
        "sql_type": {"$ref": "SqlType"},
        "nullable": {"type": "boolean"}
      },
      "required": ["name", "source", "sql_type"],
      "unevaluatedProperties": false
    },
    "TableProjection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "TableProjection",
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "model": {"type": "string"},
        "primary_key": {"type": "string"},
        "columns": {"type": "array", "items": {"$ref": "ColumnProjection"}}
      },
      "required": ["name", "model", "primary_key", "columns"],
      "unevaluatedProperties": false
    },
    "SeedProjection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SeedProjection",
      "type": "object",
      "properties": {
        "table": {"type": "string"},
        "rows": {"type": "array", "items": {}}
      },
      "required": ["table", "rows"],
      "unevaluatedProperties": false
    },
    "ProtoFieldProjection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ProtoFieldProjection",
      "type": "object",
      "properties": {
        "type": {"type": "string"},
        "name": {"type": "string"},
        "number": {"type": "integer"}
      },
      "required": ["type", "name", "number"],
      "unevaluatedProperties": false
    },
    "ProtoMessageProjection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ProtoMessageProjection",
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "fields": {"type": "array", "items": {"$ref": "ProtoFieldProjection"}}
      },
      "required": ["name", "fields"],
      "unevaluatedProperties": false
    },
    "ProtoRpcProjection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ProtoRpcProjection",
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "request": {"type": "string"},
        "response": {"type": "string"}
      },
      "required": ["name", "request", "response"],
      "unevaluatedProperties": false
    },
    "ProtoProjection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ProtoProjection",
      "type": "object",
      "properties": {
        "package": {"type": "string"},
        "service": {"type": "string"},
        "messages": {"type": "array", "items": {"$ref": "ProtoMessageProjection"}},
        "rpcs": {"type": "array", "items": {"$ref": "ProtoRpcProjection"}}
      },
      "required": ["package", "service", "messages", "rpcs"],
      "unevaluatedProperties": false
    },
    "InterfaceProjection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "InterfaceProjection",
      "type": "object",
      "properties": {"model": {"type": "string"}},
      "required": ["model"],
      "unevaluatedProperties": false
    },
    "ProjectionContract": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ProjectionContract",
      "type": "object",
      "properties": {
        "schema": {"$ref": "ProjectionSchema"},
        "scenario": {"$ref": "ProjectionScenario"},
        "tables": {"type": "array", "items": {"$ref": "TableProjection"}},
        "seed": {"type": "array", "items": {"$ref": "SeedProjection"}},
        "proto": {"$ref": "ProtoProjection"},
        "interfaces": {"type": "array", "items": {"$ref": "InterfaceProjection"}}
      },
      "required": ["schema", "scenario", "tables", "seed", "proto", "interfaces"],
      "unevaluatedProperties": false
    }
  }
}
